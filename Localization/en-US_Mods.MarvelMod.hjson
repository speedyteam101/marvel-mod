Items: {
	ArcReactorMk1: {
		DisplayName: Arc Reactor Mk I
		Tooltip:
			'''
			Lets you suit up as Iron Man (Suit Up key, or right-click the Stark Tablet)
			{0}
			Grants the Repulsors and Shoulder Weapon abilities while suited up
			"Proof that Tony Stark has a heart."
			'''
	}

	ArcReactorMk2: {
		DisplayName: Arc Reactor Mk II
		Tooltip:
			'''
			Lets you suit up as Iron Man (Suit Up key, or right-click the Stark Tablet)
			{0}
			Also grants the chest Unibeam while suited up
			'''
	}

	ArcReactorMk3: {
		DisplayName: Arc Reactor Mk III
		Tooltip:
			'''
			Lets you suit up as Iron Man (Suit Up key, or right-click the Stark Tablet)
			{0}
			The suit also becomes immune to lava
			'''
	}

	StarkTablet: {
		DisplayName: Stark Tablet
		Tooltip:
			'''
			Left click to open the Suit Workshop (buy new parts from its Parts Store button)
			Right click to suit up or down (needs an Arc Reactor equipped)
			'''
	}

	Repulsors: {
		DisplayName: Repulsors
		Tooltip:
			'''
			Fire repulsor blasts from your palms
			Changes with the suit's Repulsor Mode
			'''
	}

	ShoulderWeapon: {
		DisplayName: Shoulder Weapon
		Tooltip:
			'''
			Fires the suit's shoulder-mounted weapon
			Choose micro-missiles, minigun, flares, laser, a heavy rocket or cluster bombs in the Suit Workshop
			'''
	}

	WeaponOne: {
		DisplayName: Weapon I
		Tooltip:
			'''
			Uses the weapon attached to the suit's Weapon Slot I
			Buy weapons in the Parts Store and attach them in the Suit Workshop
			'''
	}

	WeaponTwo: {
		DisplayName: Weapon II
		Tooltip:
			'''
			Uses the weapon attached to the suit's Weapon Slot II
			Buy weapons in the Parts Store and attach them in the Suit Workshop
			'''
	}

	TitanPunch: {
		DisplayName: Titan Punch
		Tooltip: "[Giant suit] A huge punch that sends enemies flying"
	}

	GroundPound: {
		DisplayName: Ground Pound
		Tooltip:
			'''
			[Giant suit] Slam into the ground for a massive shockwave
			Used in the air, you dive first
			4 second cooldown
			'''
	}

	MegaRepulsor: {
		DisplayName: Mega Repulsor
		Tooltip: "[Giant suit] An enormous repulsor blast that explodes"
	}

	MissileBarrage: {
		DisplayName: Missile Barrage
		Tooltip:
			'''
			[Giant suit] Launch 12 homing missiles
			8 second cooldown
			'''
	}

	GiantUnibeam: {
		DisplayName: Giant Unibeam
		Tooltip:
			'''
			[Giant suit] Hold to fire a Unibeam three times as wide
			Shares the Unibeam's overheat cooldown
			'''
	}

	ShockwaveClap: {
		DisplayName: Shockwave Clap
		Tooltip:
			'''
			[Giant suit] Clap to send a shockwave rolling along the ground
			3 second cooldown
			'''
	}

	RocketCharge: {
		DisplayName: Rocket Charge
		Tooltip:
			'''
			[Giant suit] Rocket towards the cursor, ramming everything in the way
			5 second cooldown
			'''
	}

	ShieldDome: {
		DisplayName: Shield Dome
		Tooltip:
			'''
			[Giant suit] For 6 seconds: take 40% less damage and enemy projectiles that reach the dome are destroyed
			30 second cooldown
			'''
	}

	OrbitalStrike: {
		DisplayName: Orbital Strike
		Tooltip:
			'''
			[Giant suit] Mark the cursor's position; a moment later a beam strikes from orbit
			20 second cooldown
			'''
	}

	Unibeam: {
		DisplayName: Unibeam
		Tooltip:
			'''
			Hold to fire a beam from the Arc Reactor
			Overheats after a few seconds and has to cool down
			Changes with the suit's Unibeam Mode
			'''
	}
}

